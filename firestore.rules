rules_version = '2';
// Who can read and write what. Deploy with: npx firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    // You make someone an admin by creating admins/<their user ID> in the Firebase console.
    // Admin powers only count when that person logged in with Google this session, so a stolen
    // KASA.Rx password alone gives an ordinary account, and Google's 2-Step Verification guards admin.
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, max) { return v is string && v.size() <= max; }
    // One plain address: no spaces, commas, angle brackets or line breaks (so nothing can be added to an email's headers)
    function oneEmail(v) { return str(v, 254) && v.matches('^[^@\\s,;<>"]+@[^@\\s,;<>"]+[.][^@\\s,;<>"]+$'); }
    function pdfAttachment(a) {
      return a is map && a.keys().hasOnly(['filename', 'mimeType', 'content'])
        && a.mimeType == 'application/pdf'
        && str(a.filename, 80) && a.filename.matches('^[A-Za-z0-9 ._-]+[.]pdf$')
        && str(a.content, 700000);
    }
    function today() { return math.floor(request.time.toMillis() / 86400000); }

    // The person's name/email for the admin list; only they can change it.
    match /users/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'created', 'lastLogin'])
        && str(request.resource.data.name, 120)
        && request.resource.data.email == request.auth.token.email;
      allow delete: if me(uid);

      // The person's tracker: nobody else, not even the admin, can read it.
      match /docs/{docId} {
        allow read, write: if me(uid);
      }
      // Receipt photos for expenses: private to the person, one image per document.
      match /receipts/{receiptId} {
        allow read, delete: if me(uid);
        allow create, update: if me(uid) && request.resource.data.image is string && request.resource.data.image.size() < 1000000;
      }
    }

    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'topic', 'rating', 'message', 'at', 'ts'])
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.name, 120) && str(request.resource.data.topic, 60)
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && str(request.resource.data.message, 5000);
      allow read, delete: if isAdmin();
      // People can find and delete their own feedback (when they delete their account)
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Emails an account holder asks the admin to send from the admin's Gmail.
    // Nothing is sent automatically: the admin reads and sends (or rejects) each one.
    // Only people with a confirmed email can queue, one plain recipient each, a PDF at most,
    // and no more than 10 a day (counted in outboxQuota, written in the same batch).
    match /outbox/{id} {
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'kind', 'invoiceId', 'invoiceNumber', 'to', 'subject', 'body', 'attachment', 'status', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'kind', 'invoiceId', 'invoiceNumber', 'to', 'subject', 'body', 'status', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'new'
        && request.resource.data.kind in ['invoice', 'followup']
        && oneEmail(request.resource.data.to)
        && str(request.resource.data.name, 120)
        && str(request.resource.data.invoiceId, 64) && str(request.resource.data.invoiceNumber, 40)
        && str(request.resource.data.subject, 200) && str(request.resource.data.body, 6000)
        && str(request.resource.data.at, 40)
        && (!('attachment' in request.resource.data) || pdfAttachment(request.resource.data.attachment))
        && getAfter(/databases/$(database)/documents/outboxQuota/$(request.auth.uid)).data.last == id;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // How many emails each person has queued today. Each new outbox item must bump this in the same write.
    match /outboxQuota/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if me(uid)
        && request.resource.data.keys().hasOnly(['day', 'n', 'last'])
        && request.resource.data.day == today()
        && request.resource.data.n == ((resource == null || resource.data.day != today()) ? 1 : resource.data.n + 1)
        && request.resource.data.n <= 10
        && request.resource.data.last is string
        && !exists(/databases/$(database)/documents/outbox/$(request.resource.data.last))
        && existsAfter(/databases/$(database)/documents/outbox/$(request.resource.data.last));
      allow delete: if me(uid);
    }

    // Crash reports from signed-in people (no tracker data): only the admin can read or clear them.
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['at', 'message', 'stack', 'page', 'ua', 'uid', 'version'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.at, 40) && str(request.resource.data.message, 500) && str(request.resource.data.stack, 2000)
        && str(request.resource.data.page, 60) && str(request.resource.data.ua, 200) && str(request.resource.data.version, 40);
      allow read, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /admins/{uid} {
      allow read: if me(uid);
      allow write: if false;
    }

    // Admin name and switches; everyone can read them.
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
